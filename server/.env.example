# contoh env backend - jangan commit yang asli
PORT=5000
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Bot Telegram (opsional)
# 1. Buat bot via @BotFather -> dapat token
# 2. Set webhook: https://api.telegram.org/botTOKEN/setWebhook?url=https://APIKAMU/api/telegram/webhook&secret_token=RAHASIA
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Reset password email via Resend (https://resend.com)
# 1. Daftar Resend -> buat API key -> isi RESEND_API_KEY
# 2. Untuk testing bisa pakai MAIL_FROM=onboarding@resend.dev (hanya ke email pendaftar Resend)
#    Untuk produksi, verifikasi domain sendiri lalu pakai mis. "My Economy <noreply@domainkamu.com>"
RESEND_API_KEY=
MAIL_FROM=
APP_NAME=My Economy
# Opsional: URL lanjutan setelah reset (mis. halaman login web kamu)
# PASSWORD_RESET_CONTINUE_URL=https://domainkamu.com/login
# Halaman reset password custom (ganti halaman polos bawaan Firebase).
# Produksi: url halaman /reset-password web kamu. Lokal: http://localhost:5173/reset-password
PASSWORD_RESET_HANDLER_URL=https://myekonomi.netlify.app/reset-password
